rules_version = '2';

// Each signed-in user can only read/write their own subtree
// (users/{their own uid}/...). Nobody can read or write another
// user's data, and signed-out requests are rejected entirely.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
